dback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [{"content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Organize the mystery sentence.</span> <span class=\"bullet\">Move each word to place it in the correct order.</span>", "type": "text"}], "type": "post_instructions"}], "id": 9, "type": "WSB"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 0}, {"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 1, "correct": 1}], "_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"content": "Quiz", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "type": "RSLT"}, {"questions": [{"responses": [{"_data": [{"content": "", "type": "text"}], "selected": 0, "id": 0, "correct": 1}], "_data": [{"contents": [{"content": "enpe7n5le03ob02re7pdf01.pdf", "type": "pdf"}], "type": "question"}], "id": 0}], "template_override": 1, "stimuli_ids": [], "_data": [{"contents": [{"content": " Using C# and .NET Framework", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Take Away", "type": "group_name"}], "type": "group"}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}], "type": "learning_skills"}, {"contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}], "type": "post_instructions"}], "id": 11, "type": "DWS"}], "_data": [{"contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}], "type": "lab_options"}], "stimuli": [{"_data": [], "contents": [{}], "template_override": 1, "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "id": 1, "contents": [{"value": {"coverimg": "enpe7n5le03ob02re2img01.jpg", "images": [{"time": "0", "text": "<strong>Charles: </strong>Sorry, Lily. I have some questions, and I think you could help me with them. What is the .NET framework?</br>\n<strong>Lily: </strong>It's a platform that helps you write web services and Windows and web applications. It comprises a huge library of codes that you can use from several languages, including C#. Even though you find the word \"framework\" on this tool's name, it's not only that; it also provides the Common Language Runtime (CLR), which is a runtime environment that handles management, exceptions, and security. </br>\n<strong>Charles: </strong>What are the advantages of providing a runtime environment? </br>\n<strong>Lily: </strong> The biggest advantage is portability. This means that programmers can use any language and that they can run the code they develop on any hardware on which .NET is supported, thanks to having multi-platform applications. </br>", "image": "enpe7n5le03ob02re2img01.jpg", "id": 0}, {"time": "58000", "text": "<strong>Charles: </strong>Can I write any application in C#?</br>\n<strong>Lily: </strong> Yes! The .NET framework allows C# to operate smoothly with Windows; it's the best option available. You program the applications by using an Integrated Development Environment (IDE), which depends on the programming language you use; you can program from the most basic to the biggest and most complex applications. You can find at least a pair of development tools for C# programming on the internet for free download; for some others, you need to pay. </br>\n<strong>Charles: </strong> Where can I run C#?</br>\n<strong>Lily: </strong> It runs on the Windows operating system. </br>", "image": "enpe7n5le03ob02re2img02.jpg", "id": 1}, {"time": "100000", "text": "<strong>Charles: </strong> And if I have a Mac? </br>\n<strong>Lily: </strong> There are some other programming tools that work on other operating systems. </br>\n<strong>Charles: </strong>What can I do if I have problems with .NET? </br>\n<strong>Lily: </strong> Problems with more modern versions of .NET are very unlikely to happen because the required versions are included in Windows. On older versions of Windows, you have to uninstall and then reinstall a new version of .NET to get things working. </br>\n<strong>Charles: </strong> Okay. Thank you very much for your collaboration; it is of great help. </br>\n<strong>Lily: </strong> You're welcome!", "image": "enpe7n5le03ob02re2img03.jpg", "id": 2}], "audiosrc": "enpe7n5le03ob02re2aud01"}, "type": "slideshow"}]}], "id": 0, "type": "scholar"}]}